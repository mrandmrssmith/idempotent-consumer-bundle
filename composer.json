{
    "name": "mrandmrssmith/idempotent-consumer-bundle",
    "description": "idempotent-consumer-bundle",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "symfony/dependency-injection": "^3.4 || ^4.4 || ^5.4 || ^6.4 || ^7.4",
        "symfony/http-kernel": "^3.4 || ^4.4 || ^5.4 || ^6.4 || ^7.4",
        "symfony/config": "^3.4 || ^4.4 || ^5.4 || ^6.4 || ^7.4"
    },
    "authors": [
        {
            "name": "Michal Boryczko",
            "email": "michal.boryczko@smithhotels.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "MrAndMrsSmith\\IdempotentConsumerBundle\\": "./src",
            "Tests\\UnitTests\\" : "./tests/UnitTests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "require-dev": {
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpunit/phpunit": ">=8.5",
        "symplify/easy-coding-standard": "^12.1",
        "vimeo/psalm": "^4.30||^5.22"
    },
    "prefer-stable": true
}
